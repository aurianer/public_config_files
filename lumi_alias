###############################################################################
# PYTHON redefinition with another python version
unalias pyvenv 2> /dev/null
alias pyvenv='python3.6 -m venv'

unset -f create_venv
function create_venv() {
    if [[ "$#" == 0 ]]; then
	error_missing_args "${FUNCNAME}"
	usage_func "${FUNCNAME} <env_name>"
    else
	echo "Rk : Default python version used to create the env is 3.7"
	python3.7 -m venv ${1}
	echo "${1} environment created"
    fi
}

function spack_setup() {
    export SPACK_ROOT=$PROJECT/spack_common
    export SPACK_USER_CONFIG_PATH=$SPACK_ROOT/.spack_default_config
    export SPACK_USER_CACHE_PATH=$SPACK_ROOT/.spack_default_cache
    . $SPACK_ROOT/share/spack/setup-env.sh
}

function spack_setup_pytorch() {
    export SPACK_ROOT=$SCRATCH/install/spack_pytorch
    export SPACK_USER_CONFIG_PATH=$SPACK_ROOT/.spack_default_config
    export SPACK_USER_CACHE_PATH=$SPACK_ROOT/.spack_default_cache
