# A file for new aliases and commands (makes the .bashrc much cleaner)

# We load common aliases (accross several platforms)
test -s ~/.common_alias && . ~/.common_alias || true
test -s ~/.alias_slurm && . ~/.alias_slurm || true

# Allocation aliases bound to the cluster
alias sall='salloc  --account=project_465000105 -N1 -n1 --gpus-per-task=1 --partition=dev-g -t90'
#alias sall='salloc --partition=eap --account=project_465000105 -N1 -n1 --gpus-per-task=1 -t10'
alias sall_hw='srun --partition=eap --account=project_465000105 -N1 -n1 --gpus-per-task=1 rocm-smi --showhw'
alias sall_standard='salloc --partition=standard --account=project_465000105 -N1 -n1 -t30'
alias si_avail_nodes='si_avail_nodes amdvega'
alias list_usage='lumi-allocations'

function spack_setup() {
    export SPACK_ROOT=$PROJECT/spack_common
    export SPACK_USER_CONFIG_PATH=$SPACK_ROOT/.spack_default_config
    export SPACK_USER_CACHE_PATH=$SPACK_ROOT/.spack_default_cache
    . $SPACK_ROOT/share/spack/setup-env.sh
}

function spack_setup_pytorch() {
    export SPACK_ROOT=$SCRATCH/install/spack_pytorch
    export SPACK_USER_CONFIG_PATH=$SPACK_ROOT/.spack_default_config
    export SPACK_USER_CACHE_PATH=$SPACK_ROOT/.spack_default_cache
    . $SPACK_ROOT/share/spack/setup-env.sh
}

# Using the shared instance of spack on LUMI
function spack_setup_ssa() {
    export SPACK_ROOT=/projappl/project_465000105/spack
    export SPACK_USER_CONFIG_PATH=$PROJECT/spack_common/.spack_ssa_config
    export SPACK_USER_CACHE_PATH=$PROJECT/spack_common/.spack_ssa_cache
    . $SPACK_ROOT/share/spack/setup-env.sh
}
